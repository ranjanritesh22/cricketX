# ── Data provider selection ──────────────────────────────────────────────
# One of: mock | cricsheet | cricketdata | entitysport
# The app boots fully in `mock` mode with ZERO keys — fixtures are bundled.
DATA_PROVIDER=mock

# Directory of Cricsheet match JSON files (used when DATA_PROVIDER=cricsheet).
# A real sample match ships in data/cricsheet/. Cricsheet data is ODC-BY licensed.
CRICSHEET_DIR=data/cricsheet

# ── Provider credentials (only needed for the matching DATA_PROVIDER) ───
CRICKETDATA_API_KEY=
ENTITYSPORT_TOKEN=

# ── Live pipeline (Phase 2) ─────────────────────────────────────────────
# Leave BOTH unset for zero-config dev: live state lives in-process and the
# SSE route polls the provider once per match while clients are connected.
# Set both to switch to Upstash Redis snapshots (serverless/multi-instance);
# then /api/sync (cron/QStash/worker) becomes the poller.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/sync in production: call with `Authorization: Bearer <secret>`
# or `?secret=`. Unset = open (local dev only).
SYNC_SECRET=

# Optional — Stage-2 LLM fallback parser only (Phase 5). Enabled when the key
# is set; force off with SYNTH_LLM=0. App is fully functional without it.
ANTHROPIC_API_KEY=
SYNTH_LLM=

NEXT_PUBLIC_APP_URL=http://localhost:3000
